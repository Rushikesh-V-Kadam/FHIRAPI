<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    FHIR API
    Converts the EHR's plain REST/JSON APIs into FHIR R4 (US Core 3.1.1 / Da Vinci CRD profiles)
    and hosts the SMART on FHIR launch used by the DTR app.
    All FHIR model classes are written in this project (Models/Fhir) - no FHIR SDK package is used.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FHIRAPI</RootNamespace>
    <!-- XML comments are shown in Swagger UI -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swagger UI (testing and documentation only) -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
