{
  "Urls": "http://localhost:5100",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "QuestionnaireResponseStore": "EhrApi"
  },
  "Ehr": {
    "BaseUrl": "http://localhost:5090",
    "DataPath": "api/prior-auth-data",
    "TimeoutSeconds": 300
  },
  "FhirServer": {
    "PublicBaseUrl": "http://localhost:5100/fhir/r4",
    "MaxPageSize": 100
  },
  "Swagger": {
    // false = the "DTR forms" and "SMART launch context" sections are hidden in Swagger UI (not needed yet).
    // The endpoints keep working: the Payer Gateway and payer DTR apps call them. Set true to show them again.
    "ShowDtrSections": false
  }
}
