{
  "Urls": "http://localhost:5100",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "QuestionnaireResponseStore": "EhrApi",
    // SMART apps, launches, codes and tokens (BuiltIn) or launches only (Keycloak): "EhrApi" (EHR database, needed with more than one server) or "InMemory"
    "SmartStore": "EhrApi"
  },
  "Security": {
    // Who issues the SMART / fhirAuthorization tokens: "BuiltIn" (this API) or "Keycloak".
    // TODO: Keycloak is still being discussed; keep "BuiltIn" until Keycloak is set up (see the Keycloak configuration guide).
    "TokenProvider": "BuiltIn",
    // true = /fhir/r4 calls need a Bearer token from the TokenProvider (or the internal key). false = no check here.
    // TODO: authentication is turned off for now (no auth between the Payer Gateway, this API and the mock EHR).
    // Set true (and set InternalApiKey) when authentication is turned on again.
    "ValidateAccessTokens": false,
    // TODO: empty for now = no X-Api-Key check on /internal. When authentication is turned on again, use a long
    // random value per environment (encrypted settings file); the Payer Gateway sends the same value as FhirApi:ApiKey.
    "InternalApiKey": "",
    // BuiltIn only: lifetime of a SMART app token, in seconds (at most one hour)
    "SmartTokenSeconds": 3600,
    // BuiltIn and Storage:SmartStore = "InMemory" only (local testing). With "EhrApi" the apps come from PA_SMART_CLIENT.
    "LocalClients": []
  },
  "Keycloak": {
    // Used only when Security:TokenProvider = "Keycloak".
    // TODO: local test realm. The realm address exactly as in the "iss" of Keycloak's tokens, e.g.
    // https://keycloak.provider.example/realms/ehr. SMART apps sign in and get their tokens there.
    "Authority": "http://localhost:8080/realms/ehr",
    // Optional: where this API reads Keycloak's keys when it reaches Keycloak by another (internal) address. Empty = Authority.
    "MetadataAddress": "",
    // Accepted "aud" of a token. Empty = the FHIR base URL (FhirServer:PublicBaseUrl); Keycloak's Audience mapper adds it.
    "Audiences": [],
    // TODO: false only for local testing over http; true in production (Keycloak over https).
    "RequireHttpsMetadata": false,
    "ClockSkewSeconds": 60
  },
  "Ehr": {
    "BaseUrl": "http://localhost:5090",
    "DataPath": "api/prior-auth-data",
    "TimeoutSeconds": 300
  },
  "FhirServer": {
    "PublicBaseUrl": "http://localhost:5100/fhir/r4",
    "MaxPageSize": 100
  }
}
