{
  "Urls": "http://localhost:5100",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "QuestionnaireResponseStore": "EhrApi"
  },
  "Ehr": {
    "BaseUrl": "http://localhost:5090",
    "DataPath": "api/prior-auth-data",
    "TimeoutSeconds": 300
  },
  "FhirServer": {
    "PublicBaseUrl": "http://localhost:5100/fhir/r4",
    "MaxPageSize": 100
  },
  "SmartConfiguration": {
    "Issuer": "https://login.microsoftonline.com/TENANT-ID/v2.0",
    "JwksUri": "https://login.microsoftonline.com/TENANT-ID/discovery/v2.0/keys",
    "AuthorizationEndpoint": "https://login.microsoftonline.com/TENANT-ID/oauth2/v2.0/authorize",
    "TokenEndpoint": "https://login.microsoftonline.com/TENANT-ID/oauth2/v2.0/token",
    "IntrospectionEndpoint": "",
    "RevocationEndpoint": "",
    "RegistrationEndpoint": "",
    "ManagementEndpoint": "",
    "GrantTypesSupported": [
      "authorization_code"
    ],
    "CodeChallengeMethodsSupported": [
      "S256"
    ],
    "TokenEndpointAuthMethodsSupported": [
      "client_secret_post",
      "client_secret_basic",
      "private_key_jwt"
    ],
    "ResponseTypesSupported": [
      "code"
    ],
    "Capabilities": [
      "launch-ehr",
      "client-public",
      "client-confidential-symmetric",
      "client-confidential-asymmetric",
      "sso-openid-connect",
      "context-ehr-patient",
      "context-ehr-encounter",
      "permission-patient",
      "permission-v2"
    ],
    "ScopesSupported": [
      "openid",
      "fhirUser",
      "launch",
      "patient/Patient.rs",
      "patient/Coverage.rs",
      "patient/Encounter.rs",
      "patient/ServiceRequest.rs",
      "patient/MedicationRequest.rs",
      "patient/Practitioner.rs",
      "patient/PractitionerRole.rs",
      "patient/Organization.rs",
      "patient/Location.rs",
      "patient/Observation.rs",
      "patient/Condition.rs",
      "patient/Procedure.rs",
      "patient/DocumentReference.rs",
      "patient/QuestionnaireResponse.cru"
    ]
  }
}
