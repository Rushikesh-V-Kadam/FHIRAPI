{
  "Urls": "http://localhost:5100",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "QuestionnaireResponseStore": "EhrApi",
    // SMART apps, launches, codes and access tokens: "EhrApi" (EHR database, needed with more than one server) or "InMemory"
    "SmartStore": "EhrApi"
  },
  "Security": {
    // true = /fhir/r4 calls need a Bearer token issued by this API (or the internal key). false = no check here.
    // TODO: authentication is turned off for now (no auth between the Payer Gateway, this API and the mock EHR).
    // Set true (and set InternalApiKey) when authentication is turned on again.
    "ValidateAccessTokens": false,
    // TODO: empty for now = no X-Api-Key check on /internal. When authentication is turned on again, use a long
    // random value per environment (encrypted settings file); the Payer Gateway sends the same value as FhirApi:ApiKey.
    "InternalApiKey": "",
    // Lifetime of a SMART app token, in seconds (at most one hour)
    "SmartTokenSeconds": 3600,
    // SMART apps for Storage:SmartStore = "InMemory" only (local testing). With "EhrApi" they come from PA_SMART_CLIENT.
    "LocalClients": []
  },
  "Ehr": {
    "BaseUrl": "http://localhost:5090",
    "DataPath": "api/prior-auth-data",
    "TimeoutSeconds": 300
  },
  "FhirServer": {
    "PublicBaseUrl": "http://localhost:5100/fhir/r4",
    "MaxPageSize": 100
  }
}
